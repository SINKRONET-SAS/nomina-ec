{
  "schemaVersion": 1,
  "planCode": "ONI26",
  "phase": "ONI26-12",
  "purpose": "Catálogo de reportes de nómina y exportaciones auditables.",
  "reports": [
    {
      "code": "LABORAL_DECIMO_TERCERO",
      "name": "Reporte anual de décimo tercero",
      "exports": ["xlsx"],
      "permissions": ["reports.export"],
      "filters": ["fiscalYear", "employeeId", "department", "position", "costCenter"],
      "status": "preparatory",
      "officialValidation": "SUT/MDT"
    },
    {
      "code": "LABORAL_DECIMO_CUARTO",
      "name": "Reporte anual de décimo cuarto",
      "exports": ["xlsx"],
      "permissions": ["reports.export"],
      "filters": ["fiscalYear", "employeeId", "department", "position", "costCenter"],
      "status": "preparatory",
      "officialValidation": "SUT/MDT"
    },
    {
      "code": "LABORAL_PARTICIPACION_UTILIDADES",
      "name": "Participación laboral y utilidades",
      "exports": ["xlsx"],
      "permissions": ["reports.export"],
      "filters": ["fiscalYear", "utilidadLiquida", "employeeId", "department", "position", "costCenter"],
      "status": "preparatory",
      "officialValidation": "SUT/MDT"
    },
    {
      "code": "LABORAL_SALARIO_DIGNO",
      "name": "Salario digno",
      "exports": ["xlsx"],
      "permissions": ["reports.export"],
      "filters": ["fiscalYear", "salarioDignoMensual", "utilidadCompensacion", "employeeId", "department", "position", "costCenter"],
      "status": "preparatory",
      "officialValidation": "SUT/MDT"
    },
    {
      "code": "LABORAL_BENEFICIOS_ACUMULADOS",
      "name": "Beneficios laborales acumulados",
      "exports": ["xlsx"],
      "permissions": ["reports.export"],
      "filters": ["fiscalYear", "employeeId", "department", "position", "costCenter"],
      "status": "preparatory",
      "officialValidation": "SUT/MDT"
    },
    {
      "code": "PAYROLL_SUMMARY",
      "name": "Resumen de nómina",
      "exports": ["pdf", "xlsx", "csv"],
      "permissions": ["reports.read", "reports.export"],
      "filters": ["periodId", "departmentId", "costCenterId"]
    },
    {
      "code": "PAYROLL_DETAIL_TABULAR",
      "name": "Detalle tabular de nómina",
      "exports": ["xlsx", "csv"],
      "permissions": ["reports.export"],
      "filters": ["periodId", "employeeId", "departmentId"]
    },
    {
      "code": "PAYROLL_BENEFIT_MOVEMENT_BALANCE",
      "name": "Ledger individual de beneficios y saldos",
      "exports": ["xlsx", "csv"],
      "permissions": ["reports.export"],
      "filters": ["fiscalYear", "employeeId", "departmentId", "costCenterId"]
    },
    {
      "code": "BANK_PAYMENT_RECONCILIATION",
      "name": "Conciliacion de pagos bancarios",
      "exports": ["pdf", "xlsx"],
      "permissions": ["bankFiles.download", "reports.export"],
      "filters": ["periodId", "bankProfile"]
    },
    {
      "code": "RDEP_PRECHECK",
      "name": "Prevalidacion RDEP",
      "exports": ["xlsx"],
      "permissions": ["reports.export"],
      "filters": ["fiscalYear"]
    }
  ],
  "pdf": {
    "requiresGeneratedAt": true,
    "requiresCorrelationId": true,
    "requiresTenantWatermark": true
  },
  "excel": {
    "format": "tabular",
    "oneHeaderRow": true,
    "mergedCells": false,
    "machineReadable": true
  },
  "privacy": {
    "maskSensitiveFieldsByDefault": true,
    "exportRequiresAudit": true
  }
}
